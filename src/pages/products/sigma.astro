---
import ArrowDown from "../../components/ui/ArrowDown.astro";
import ExternalArrow from "../../components/ui/ExternalArrow.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import StatusBadge from "../../components/ui/StatusBadge.astro";
import { projects } from "../../data/projects";
import BaseLayout from "../../layouts/BaseLayout.astro";

const project = projects.sigma;
const githubUrl = project.links.find(
  (link) => "external" in link && link.external
)?.href;
const heroSrcset = project.media.heroSources
  ?.map(({ src, width }) => `${src} ${width}w`)
  .join(", ");

const useCases = [
  {
    label: "Film editing",
    body: "Lay out selects, references, and takes spatially to plan a cut before touching a timeline editor."
  },
  {
    label: "Dataset triage",
    body: "Scan and sort large batches of clips or images for ML/dataset review by eye, arranging them by similarity or quality instead of scrolling a directory listing."
  },
  {
    label: "Moodboarding",
    body: "Pull in massive video clips and stills side by side to build a visual reference board without pre-cropping everything down to thumbnails."
  },
  {
    label: "Research boards",
    body: "Assemble large visual research or evidence collections where spatial position and proximity carry meaning a flat list can't."
  },
  {
    label: "Generative workflows",
    body: "Drop a batch of media down and think about it spatially, including outputs streamed in from a connected generation pipeline."
  }
] as const;

const studioFeatures = [
  "Single infinite canvas",
  "Native rendering through Tauri's WebView",
  "Standard JPG / MP4 workflows",
  "1080p-oriented H.264 export",
  "Shapes, pen, text, color, and border annotation",
  "ComfyUI browser and execution (WIP)"
] as const;

const renderLabFeatures = [
  "Multiple, project-based workspaces",
  "wgpu-accelerated direct render pipeline",
  "4K+, ProRes, and wide-gamut export",
  "Live asset streaming",
  "RAW, 3D (OBJ/STL), and EXR asset support",
  "Asset tagging, executable pipelines, masking",
  "Cloud compute and folder-watching workflows"
] as const;

const technologyDetails = [
  ["Frontend", "React + TypeScript"],
  ["Desktop runtime", "Tauri"],
  ["Systems", "Rust"],
  ["Media", "FFmpeg"],
  ["UI kit", "Tailwind / shadcn"],
  ["Testing", "Vitest, Playwright, Criterion"]
] as const;
---

<BaseLayout
  title="SIGMA Canvas Studio | Asynthetic"
  description={project.metaDescription}
  socialDescription="A local-first infinite spatial canvas for organizing, visualizing, and editing media, from video to high-resolution imagery."
  canonicalPath="/products/sigma/"
  image={project.media.socialImage}
  bodyProduct="sigma"
  preloadImage={project.media.hero}
>
  <main id="main">
    <section class="product-hero">
      <div class="container container--wide">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Asynthetic</a>
          <span aria-hidden="true">/</span>
          <span>SIGMA</span>
        </nav>

        <div class="product-hero__top">
          <img
            class="product-hero__wordmark"
            src={project.media.wordmark}
            alt="SIGMA"
            width="266"
            height="38"
          />
        </div>

        <h1>Think spatially about media.</h1>
        <p class="product-hero__lede">
          SIGMA Canvas Studio is a high-performance, local-first infinite
          spatial canvas designed for organizing, visualizing, and editing media
          assets. From video to high-resolution imagery on an effectively
          unbounded workspace instead of a folder tree.
        </p>

        <div class="product-hero__meta">
          {
            project.status.map((status) => (
              <StatusBadge variant="shipped">{status}</StatusBadge>
            ))
          }
          <StatusBadge variant="planned">Apache 2.0</StatusBadge>
        </div>

        <div class="btn-row">
          {
            githubUrl && (
              <a
                class="btn btn--primary"
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                View on GitHub
                <ExternalArrow size={14} />
              </a>
            )
          }
          <a class="btn btn--ghost" href="#capabilities">
            Explore capabilities
            <ArrowDown />
          </a>
        </div>

        <div class="product-hero__media" data-hero-media>
          <figure class="media-frame">
            <img
              src={project.media.hero}
              srcset={heroSrcset}
              sizes="(max-width: 84rem) 92vw, 80rem"
              alt="SIGMA's infinite canvas with six media items arranged spatially: film stills, an anime frame, a landscape photo, and a video panel open with frame scrubbing, A/B loop points, and a floating edit toolbar"
              width="1600"
              height="1066"
              fetchpriority="high"
              decoding="async"
            />
            <figcaption class="media-frame__caption">
              <span>SIGMA Media Canvas: application UI</span>
              <span>source: phooning/sigma</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="demo-block section">
      <div class="container container--wide">
        <SectionHeading
          eyebrow="In motion"
          title="Panning an active canvas"
          description="Video and image clips share the same spatial surface. This capture pans across a working canvas mixing high resolution film references, animation stills, and photography, the kind of mixed-media board SIGMA is built for."
        />

        <figure class="demo-block__frame media-frame" data-reveal>
          <video
            data-autoplay-in-view
            muted
            playsinline
            controls
            preload="metadata"
            poster="/assets/sigma/sigma-demo-poster.jpg"
            width="1280"
            height="832"
          >
            <source src="/assets/sigma/sigma-demo.mp4" type="video/mp4" />
          </video>
          <figcaption class="media-frame__caption">
            <span>Canvas walkthrough, captured from the application</span>
            <span>source: phooning/sigma</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section id="capabilities" class="section">
      <div class="container container--wide">
        <SectionHeading
          eyebrow="Capabilities"
          title="What SIGMA actually does today"
          description="Grounded in the current codebase and README, separated from what's in progress or only planned."
        />

        <div>
          <article class="capability" data-reveal>
            <div class="capability__media">
              <figure class="media-frame">
                <img
                  src="/assets/sigma/sigma-detail-grid.jpg"
                  alt="A media tile sitting on SIGMA's dot-grid infinite canvas, with the toolbar and item count visible along the top edge"
                  width="900"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </div>
            <div>
              <span class="capability__index">01 · Spatial canvas</span>
              <h3>Drop media into an unbounded workspace</h3>
              <p>
                Images and video are arranged directly on an effectively
                infinite canvas rather than sorted into folders. Position and
                grouping become the organizing structure.
              </p>
              <ul>
                <li>Drag, drop, and freely arrange video and image clips</li>
                <li>Pan and zoom across a non-linear workspace</li>
                <li>Item count and canvas state tracked in the HUD</li>
              </ul>
            </div>
          </article>

          <article class="capability capability--reverse" data-reveal>
            <div class="capability__media">
              <figure class="media-frame">
                <img
                  src="/assets/sigma/sigma-detail-player.jpg"
                  alt="A video item open on the canvas showing playback controls, a scrub bar with A and B loop points, and a floating edit toolbar"
                  width="800"
                  height="1288"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </div>
            <div>
              <span class="capability__index"
                >02 · Media-native interaction</span
              >
              <h3>Video and images act as canvas objects</h3>
              <p>
                Media that plays and is editable in place. Each clip carries its
                own controls for framing and playback.
              </p>
              <ul>
                <li>Frame-accurate scrubbing</li>
                <li>A/B loop points for reviewing a segment repeatedly</li>
                <li>Resize and crop directly on the canvas</li>
                <li>Per-item toolbar for quick edits</li>
              </ul>
            </div>
          </article>

          <article class="capability" data-reveal>
            <div class="capability__media">
              <div class="arch-diagram" aria-hidden="true">
                <div class="arch-diagram__stack">
                  <div class="arch-node">React + TypeScript UI</div>
                  <div class="arch-connector"></div>
                  <div class="arch-node">Tauri IPC</div>
                  <div class="arch-connector"></div>
                  <div class="arch-node arch-node--accent">
                    Rust media pipeline
                  </div>
                  <div class="arch-connector"></div>
                  <div class="arch-node">Local media / FFmpeg</div>
                </div>
              </div>
            </div>
            <div>
              <span class="capability__index">03 · Local-first pipeline</span>
              <h3>Rust handles media, not a remote service</h3>
              <p>
                Decoding, frame access, and export run through a Rust backend
                reached over Tauri's IPC boundary, where the media stays on the
                machine it's opened on.
              </p>
              <ul>
                <li>No server or account required to use the canvas</li>
                <li>
                  Desktop V-Sync-paced playback with a low memory footprint
                </li>
                <li>FFmpeg on the local PATH powers export</li>
              </ul>
            </div>
          </article>

          <article class="capability capability--reverse" data-reveal>
            <div class="capability__media">
              <figure class="media-frame">
                <img
                  src="/assets/sigma/sigma-detail-toolbar.jpg"
                  alt="SIGMA's top toolbar with Save, Load, and Export actions, an audio track selector, and an item counter"
                  width="900"
                  height="58"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </div>
            <div>
              <span class="capability__index">04 · Persistent workflows</span>
              <h3>Save and reload a canvas layout</h3>
              <p>
                A canvas configuration—every item's position, crop, and loop
                points—can be saved and loaded back so a workspace can be reused
                as a template.
              </p>
              <ul>
                <li>Save / Load canvas state</li>
                <li>Reusable spatial workspaces for recurring tasks</li>
              </ul>
            </div>
          </article>

          <article class="capability" data-reveal>
            <div class="capability__media">
              <figure class="media-frame">
                <img
                  src="/assets/sigma/sigma-detail-export.jpg"
                  alt="Video export controls on the canvas showing playback position, A and B loop markers, and a loop toggle"
                  width="800"
                  height="120"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </div>
            <div>
              <span class="capability__index">05 · Export</span>
              <h3>Pull work back out as standard files</h3>
              <p>
                Export is intentionally basic today: H.264 output for marked A/B
                loops, still screenshots, and cropped segments, enough to get a
                clip out of the canvas and into another tool.
              </p>
              <ul>
                <li>H.264 export for A/B loop ranges</li>
                <li>Screenshot export</li>
                <li>Cropped-segment export</li>
              </ul>
            </div>
          </article>

          <article class="capability capability--reverse" data-reveal>
            <div>
              <span class="capability__index">06 · ComfyUI integration</span>
              <div class="capability__title-row">
                <h3>Watch generation output land on the canvas</h3>
                <StatusBadge variant="wip">WIP</StatusBadge>
              </div>
              <p>
                SIGMA can connect to a local ComfyUI instance so AI-generated
                output appears on the canvas as it's produced. This is under
                active development, not a finished feature, but a preview of
                direction, not a shipped capability.
              </p>
            </div>
            <div class="capability__media">
              <div class="capability__placeholder" aria-hidden="true">
                <span>No preview yet, in development</span>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container container--wide">
        <SectionHeading
          eyebrow="Why spatial"
          title="Where a canvas beats a folder tree"
          description="Use cases the project was built around: situations where a linear file browser breaks down."
        />

        <div class="use-cases" data-reveal>
          {
            useCases.map(({ label, body }) => (
              <div class="use-case">
                <div class="use-case__label">{label}</div>
                <div class="use-case__body">
                  <p>{body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container container--wide">
        <SectionHeading
          eyebrow="Roadmap"
          title="Studio today, Render Lab as direction"
          description="SIGMA's README draws a clear line between the current Studio edition and a planned Render Lab tier. Nothing in the right column ships yet."
        />

        <div class="roadmap-columns" data-reveal>
          <div class="roadmap-col">
            <div class="roadmap-col__head">
              <h3>Studio</h3>
              <StatusBadge variant="shipped">Current</StatusBadge>
            </div>
            <ul>{studioFeatures.map((feature) => <li>{feature}</li>)}</ul>
          </div>
          <div class="roadmap-col roadmap-col--planned">
            <div class="roadmap-col__head">
              <h3>Render Lab</h3>
              <StatusBadge variant="planned">Planned / exploratory</StatusBadge>
            </div>
            <ul>{renderLabFeatures.map((feature) => <li>{feature}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <section id="architecture" class="section">
      <div class="container container--wide">
        <SectionHeading
          eyebrow="Technical architecture"
          title="How it's built"
          description="A conventional web UI sits on top of a Rust media pipeline, connected through Tauri's IPC boundary rather than a network call."
        />

        <div class="arch-diagram" data-reveal>
          <div class="arch-diagram__stack">
            <div class="arch-node">React / TypeScript</div>
            <div class="arch-connector"></div>
            <div class="arch-node">Tauri IPC Boundary</div>
            <div class="arch-connector"></div>
            <div class="arch-node arch-node--accent">Rust Media Pipeline</div>
            <div class="arch-branches">
              <div class="arch-node">Media decoding</div>
              <div class="arch-node">Frame access</div>
              <div class="arch-node">Export</div>
              <div class="arch-node">Filesystem ops</div>
            </div>
          </div>
        </div>

        <div class="meta-row" data-reveal>
          {
            technologyDetails.map(([label, value]) => (
              <div class="meta-row__item">
                <span class="meta-row__label">{label}</span>
                <span class="meta-row__value">{value}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container container--wide">
        <div class="product-cta" data-reveal>
          <div>
            <h2>Read the source</h2>
            <p>
              SIGMA is Apache 2.0 licensed and developed in the open. The README
              covers setup, the test suite, and the current Studio / Render Lab
              split in more detail.
            </p>
          </div>
          {
            githubUrl && (
              <a
                class="btn btn--primary"
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                View on GitHub
                <ExternalArrow size={14} />
              </a>
            )
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
