---
import { Image, Picture } from "astro:assets";
import detailExport from "../../assets/sigma/detail-export.jpg";
import detailGrid from "../../assets/sigma/detail-grid.jpg";
import detailPlayer from "../../assets/sigma/detail-player.jpg";
import detailToolbar from "../../assets/sigma/detail-toolbar.jpg";
import ArrowDown from "../../components/ui/ArrowDown.astro";
import ContactSignal from "../../components/ui/ContactSignal.astro";
import ExternalArrow from "../../components/ui/ExternalArrow.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import StatusBadge from "../../components/ui/StatusBadge.astro";
import { projects } from "../../data/projects";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

const project = projects.sigma;
const release = project.release;
const githubUrl = project.links.find(
    (link) => "external" in link && link.external,
)?.href;
const releaseDate = new Date(`${release.date}T00:00:00Z`).toLocaleDateString(
    "en-US",
    { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" },
);

const principles = [
    {
        title: "Native scale",
        description:
            "4K video and raw hi-res photos sit on the canvas at full fidelity. No proxy thumbnails, no pre-cropping before you can think.",
    },
    {
        title: "Direct manipulation",
        description:
            "Frame, crop, scrub, and loop in place, in real time. The asset is the interface; there is no separate editor to open.",
    },
    {
        title: "Locally friendly",
        description:
            "A Rust media pipeline runs on your machine. No account, no upload, and no server between you and your files.",
    },
    {
        title: "Open to pipelines",
        description:
            "A foundation for connecting human expression and intent with external AI tools and automated processing pipelines.",
    },
] as const;

const useCases = [
    {
        label: "Film edit planning",
        body: "Lay out selects, references, and takes spatially to plan a cut before touching a timeline editor.",
    },
    {
        label: "Dataset triage",
        body: "Review large batches of clips and images by eye, arranging them by similarity or quality instead of scrolling a directory listing.",
    },
    {
        label: "Moodboarding",
        body: "Pull massive clips and stills side by side into a visual reference board, at native scale.",
    },
    {
        label: "Evidence boards",
        body: "Assemble visual research and intel collections where position and proximity carry meaning a flat list can't.",
    },
    {
        label: "Generative output",
        body: "Drop a batch of media down and think about it spatially, including results streamed in from a connected generation pipeline.",
    },
] as const;

const studioFeatures = [
    "Single infinite canvas",
    "Native rendering through Tauri's WebView",
    "Standard JPG / MP4 workflows",
    "1080p H.264 export",
    "Shapes, pen, text, color, and border annotation",
    "ComfyUI browser and execution (WIP)",
] as const;

const renderLabFeatures = [
    "Multiple, project-based workspaces",
    "wgpu-accelerated direct render pipeline",
    "4K+, ProRes, and wide-gamut export",
    "Live asset streaming",
    "RAW, 3D (OBJ/STL), and EXR asset support",
    "Asset tagging, executable pipelines, masking",
    "Cloud compute and folder-watching workflows",
] as const;

const technologyDetails = [
    ["Frontend", "React + TypeScript"],
    ["Desktop runtime", "Tauri"],
    ["Systems", "Rust"],
    ["Media", "FFmpeg"],
    ["UI kit", "Tailwind / shadcn"],
    ["Testing", "Vitest, Playwright, Criterion"],
] as const;

const prerequisites = [
    ["Rust", "pinned in rust-toolchain.toml"],
    ["Node.js", "24"],
    ["pnpm", "10.32.x"],
    ["FFmpeg", "on your PATH, for export"],
] as const;
---

<BaseLayout
    title="Sigma Canvas | Asynthetic"
    description={project.metaDescription}
    socialDescription="The operating workspace for creative media. A high-performance, locally friendly spatial canvas for 4K video, hi-res photos, and more."
    canonicalPath="/products/sigma/"
    image={project.media.socialImage}
    bodyProduct="sigma"
>
    <main id="main">
        <section class="product-hero">
            <div class="container container--wide">
                <nav class="breadcrumb" aria-label="Breadcrumb">
                    <a href="/">Asynthetic</a>
                    <span aria-hidden="true">/</span>
                    <span>Sigma Canvas</span>
                </nav>

                <div class="product-hero__intro">
                    <div class="product-hero__mark">
                        <img
                            class="product-hero__wordmark"
                            src={project.media.wordmark}
                            alt="Sigma Canvas"
                            width="266"
                            height="38"
                        />
                    </div>

                    <h1>The operating workspace for creative media.</h1>
                    <p class="product-hero__lede">
                        A high-performance, locally friendly spatial canvas for
                        organizing, visualizing, and refining media in
                        pre-production. From 4K video to raw hi-res photos,
                        frame, crop, and loop whatever you drop in, in real
                        time.
                    </p>

                    <p class="release-chip">
                        <span>v{release.version}</span>
                        <span aria-hidden="true">|</span>
                        <span>{release.channel}</span>
                        <span aria-hidden="true">|</span>
                        <span>macOS, Windows, Linux</span>
                    </p>

                    <div class="btn-row product-hero__actions">
                        <a class="btn btn--primary" href="#get">
                            Build from source
                            <ArrowDown />
                        </a>
                        <a
                            class="btn btn--ghost"
                            href={release.url}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Download v{release.version}
                            <ExternalArrow size={14} />
                        </a>
                    </div>
                </div>

                <div class="product-hero__media" data-reveal>
                    <figure class="media-frame">
                        <Picture
                            src={project.media.hero}
                            widths={[800, 1200, 1600]}
                            sizes="(max-width: 84rem) 92vw, 80rem"
                            formats={["avif", "webp"]}
                            quality={70}
                            alt="Sigma Canvas with six media items arranged spatially: film stills, an anime frame, a landscape photo, and a video panel open with frame scrubbing, A/B loop points, and a floating edit toolbar"
                            loading="eager"
                            fetchpriority="high"
                        />
                        <figcaption class="media-frame__caption">
                            <span>Sigma Canvas: application UI</span>
                            <span>v{release.version} | phooning/sigma</span>
                        </figcaption>
                    </figure>
                </div>
            </div>
        </section>

        <section class="section product-principles">
            <div class="container container--wide">
                <div class="about__intro" data-reveal>
                    <SectionHeading
                        title="A lightweight, universal alternative to file browsing."
                        description="Folders flatten media into names and thumbnails. Sigma Canvas puts video and images in spatial state, as first-class objects you can see, move, and work on together."
                    />
                </div>
                <div class="pillar-grid">
                    {principles.map((principle) => (
                        <article class="pillar" data-reveal>
                            <h3>{principle.title}</h3>
                            <p>{principle.description}</p>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <section class="demo-block section">
            <div class="container container--wide">
                <SectionHeading
                    title="Panning an active canvas"
                    description="Film references, animation stills, and photography share one surface. This capture pans across the kind of mixed-media board Sigma Canvas is built for."
                />

                <figure class="demo-block__frame media-frame" data-reveal>
                    <video
                        data-autoplay-in-view
                        muted
                        playsinline
                        controls
                        preload="none"
                        poster="/assets/sigma/sigma-demo-poster.jpg"
                        width="1280"
                        height="832"
                    >
                        <source
                            src="/assets/sigma/sigma-demo.mp4"
                            type="video/mp4"
                        />
                    </video>
                    <figcaption class="media-frame__caption">
                        <span>
                            Working preview walkthrough with multiple media
                            assets.
                        </span>
                        <span>source: phooning/sigma</span>
                    </figcaption>
                </figure>
            </div>
        </section>

        <section id="capabilities" class="section">
            <div class="container container--wide">
                <SectionHeading
                    title="What the working preview does today."
                    description="Everything below runs in the current Studio edition. Work in progress is marked."
                />

                <div>
                    <article class="capability" data-reveal>
                        <div class="capability__media">
                            <figure class="media-frame">
                                <Image
                                    src={detailGrid}
                                    alt="A media tile on Sigma Canvas's dot-grid canvas, with the toolbar and item count along the top edge"
                                />
                            </figure>
                        </div>
                        <div>
                            <span class="capability__index">
                                Spatial canvas
                            </span>
                            <h3>Drop media into an unbounded workspace</h3>
                            <p>
                                Video and images are arranged directly on an
                                infinite canvas instead of sorted into folders.
                                Position and grouping become the organizing
                                structure.
                            </p>
                            <ul>
                                <li>
                                    Drag, drop, and freely arrange video and
                                    image clips
                                </li>
                                <li>
                                    Pan and zoom across a non-linear workspace
                                </li>
                                <li>
                                    Item count and canvas state tracked in the
                                    HUD
                                </li>
                            </ul>
                        </div>
                    </article>

                    <article class="capability capability--reverse" data-reveal>
                        <div class="capability__media">
                            <figure class="media-frame">
                                <Image
                                    src={detailPlayer}
                                    alt="A video item open on the canvas showing playback controls, a scrub bar with A and B loop points, and a floating edit toolbar"
                                />
                            </figure>
                        </div>
                        <div>
                            <span class="capability__index">
                                Direct manipulation
                            </span>
                            <h3>Frame, crop, and loop in place</h3>
                            <p>
                                Media plays and edits where it sits. Each clip
                                carries its own controls for framing and
                                playback, so review happens on the canvas, not
                                in a separate window.
                            </p>
                            <ul>
                                <li>Frame-accurate scrubbing</li>
                                <li>
                                    A/B loop points for reviewing a segment
                                    repeatedly
                                </li>
                                <li>Resize and crop directly on the canvas</li>
                                <li>Per-item toolbar for quick edits</li>
                            </ul>
                        </div>
                    </article>

                    <article class="capability" data-reveal>
                        <div class="capability__media">
                            <div class="arch-diagram" aria-hidden="true">
                                <div class="arch-diagram__stack">
                                    <div class="arch-node">
                                        React + TypeScript UI
                                    </div>
                                    <div class="arch-connector"></div>
                                    <div class="arch-node">Tauri IPC</div>
                                    <div class="arch-connector"></div>
                                    <div class="arch-node arch-node--accent">
                                        Rust media pipeline
                                    </div>
                                    <div class="arch-connector"></div>
                                    <div class="arch-node">
                                        Local media / FFmpeg
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div>
                            <span class="capability__index">
                                Local performance
                            </span>
                            <h3>Rust handles media on your machine</h3>
                            <p>
                                Decoding, frame access, and export run through a
                                Rust backend across Tauri's IPC boundary. Media
                                stays on the machine it's opened on.
                            </p>
                            <ul>
                                <li>No server or account required</li>
                                <li>
                                    Playback paced to desktop V-Sync, with a low
                                    memory footprint
                                </li>
                                <li>FFmpeg on the local PATH powers export</li>
                            </ul>
                        </div>
                    </article>

                    <article class="capability capability--reverse" data-reveal>
                        <div class="capability__media">
                            <figure class="media-frame">
                                <Image
                                    src={detailToolbar}
                                    alt="Sigma Canvas's top toolbar with Save, Load, and Export actions, an audio track selector, and an item counter"
                                />
                            </figure>
                        </div>
                        <div>
                            <span class="capability__index">Workflows</span>
                            <h3>Save a layout, load it as a template</h3>
                            <p>
                                Every item's position, crop, and loop points can
                                be saved and loaded back, so a workspace becomes
                                a reusable template for recurring work.
                            </p>
                            <ul>
                                <li>Save / Load canvas state</li>
                                <li>
                                    Reusable spatial workspaces for recurring
                                    tasks
                                </li>
                            </ul>
                        </div>
                    </article>

                    <article class="capability" data-reveal>
                        <div class="capability__media">
                            <figure class="media-frame">
                                <Image
                                    src={detailExport}
                                    alt="Video export controls on the canvas showing playback position, A and B loop markers, and a loop toggle"
                                />
                            </figure>
                        </div>
                        <div>
                            <span class="capability__index">Export</span>
                            <h3>Pull work back out as standard files</h3>
                            <p>
                                Export is intentionally basic today: enough to
                                get a clip out of the canvas and into your next
                                tool.
                            </p>
                            <ul>
                                <li>H.264 export for A/B loop ranges</li>
                                <li>Screenshot export</li>
                                <li>Cropped-segment export</li>
                            </ul>
                        </div>
                    </article>

                    <article class="capability capability--reverse" data-reveal>
                        <div>
                            <span class="capability__index">
                                ComfyUI integration
                            </span>
                            <div class="capability__title-row">
                                <h3>
                                    Watch generation output land on the canvas
                                </h3>
                                <StatusBadge variant="wip">WIP</StatusBadge>
                            </div>
                            <p>
                                Connect a local ComfyUI instance and see AI
                                generation output appear on the canvas as it's
                                produced. This is in active development: a
                                preview of direction, not a shipped capability.
                            </p>
                        </div>
                        <div class="capability__media">
                            <div
                                class="capability__placeholder"
                                aria-hidden="true"
                            >
                                <span>No preview yet, in development</span>
                            </div>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <section class="section">
            <div class="container container--wide">
                <SectionHeading
                    title="Just drop media down and think spatially."
                    description="Where a linear file browser breaks down, and a canvas doesn't."
                />

                <div class="use-cases" data-reveal>
                    {useCases.map(({ label, body }) => (
                        <div class="use-case">
                            <div class="use-case__label">{label}</div>
                            <div class="use-case__body">
                                <p>{body}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <section id="get" class="section section--about get-sigma">
            <div class="container container--wide">
                <div class="about__intro" data-reveal>
                    <SectionHeading
                        title="Build it nightly. Alpha preview builds also available."
                        description="Sigma Canvas is an experimental, working preview, and main moves faster than tagged releases. Building from source is the recommended way to run it at its current preview stage."
                    />
                </div>

                <div class="get-sigma__grid">
                    <article
                        class="pillar get-option get-option--primary"
                        data-reveal
                    >
                        <div class="get-option__head">
                            <span class="pillar__index">Nightly</span>
                            <StatusBadge variant="shipped">
                                Recommended
                            </StatusBadge>
                        </div>
                        <h3>Build from main</h3>
                        <p>
                            The newest fixes, and integrations, built for your
                            own machine:
                        </p>

                        <dl class="get-option__reqs">
                            {prerequisites.map(([name, detail]) => (
                                <div>
                                    <dt>{name}</dt>
                                    <dd>{detail}</dd>
                                </div>
                            ))}
                        </dl>

                        <pre
                            class="get-option__code"
                            aria-label="Build commands"
                        ><code><span class="get-option__comment"># clone and install</span>
git clone https://github.com/phooning/sigma.git
cd sigma
pnpm install

<span class="get-option__comment"># run with hot reload</span>
pnpm run tauri dev

<span class="get-option__comment"># or bundle a native app for your OS</span>
pnpm run build
pnpm run tauri build</code></pre>

                        {githubUrl && (
                            <a
                                class="btn btn--primary"
                                href={githubUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                Open the repository
                                <ExternalArrow size={14} />
                            </a>
                        )}
                    </article>

                    <article class="pillar get-option" data-reveal>
                        <div class="get-option__head">
                            <span class="pillar__index">Release</span>
                            <StatusBadge variant="planned">
                                v{release.version}
                            </StatusBadge>
                        </div>
                        <h3>Download a preview build</h3>
                        <p>
                            Prebuilt installers from the releases channel.
                            Convenient, but they trail main so expect rough
                            edges.
                        </p>

                        <ul class="platform-list">
                            {release.platforms.map((platform) => (
                                <li>
                                    <span class="platform-list__os">
                                        {platform.os}
                                    </span>
                                    <span class="platform-list__arch">
                                        {platform.arch}
                                    </span>
                                    <span class="platform-list__formats">
                                        {platform.formats.join("  ")}
                                    </span>
                                </li>
                            ))}
                        </ul>

                        <p class="get-option__note">
                            {release.channel} | published {releaseDate}
                        </p>

                        <a
                            class="btn"
                            href={release.url}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            View releases
                            <ExternalArrow size={14} />
                        </a>
                    </article>
                </div>
            </div>
        </section>

        <section class="section">
            <div class="container container--wide">
                <SectionHeading
                    title="Studio today. Render Lab next."
                    description="The Studio edition covers core visualization and light editing. A planned Render Lab tier adds advanced capability for pros, technical needs, and lab applications still in progress."
                />

                <div class="roadmap-columns" data-reveal>
                    <div class="roadmap-col">
                        <div class="roadmap-col__head">
                            <h3>Studio</h3>
                            <StatusBadge variant="shipped">Current</StatusBadge>
                        </div>
                        <ul>
                            {studioFeatures.map((feature) => (
                                <li>{feature}</li>
                            ))}
                        </ul>
                    </div>
                    <div class="roadmap-col roadmap-col--planned">
                        <div class="roadmap-col__head">
                            <h3>Render Lab</h3>
                            <StatusBadge variant="planned">
                                Planned / exploratory
                            </StatusBadge>
                        </div>
                        <ul>
                            {renderLabFeatures.map((feature) => (
                                <li>{feature}</li>
                            ))}
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <section id="architecture" class="section">
            <div class="container container--wide">
                <SectionHeading
                    title="Rust and TypeScript on Tauri."
                    description="A conventional web UI sits on a Rust media pipeline, connected through Tauri's IPC boundary rather than a network call."
                />

                <div class="arch-diagram" data-reveal>
                    <div class="arch-diagram__stack">
                        <div class="arch-node">React / TypeScript</div>
                        <div class="arch-connector"></div>
                        <div class="arch-node">Tauri IPC Boundary</div>
                        <div class="arch-connector"></div>
                        <div class="arch-node arch-node--accent">
                            Rust Media Pipeline
                        </div>
                        <div class="arch-branches">
                            <div class="arch-node">Media decoding</div>
                            <div class="arch-node">Frame access</div>
                            <div class="arch-node">Export</div>
                            <div class="arch-node">Filesystem ops</div>
                        </div>
                    </div>
                </div>

                <div class="meta-row" data-reveal>
                    {technologyDetails.map(([label, value]) => (
                        <div class="meta-row__item">
                            <span class="meta-row__label">{label}</span>
                            <span class="meta-row__value">{value}</span>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <section id="contact" class="section section--contact">
            <div class="container container--wide">
                <div class="contact-layout">
                    <div class="contact-copy">
                        <SectionHeading
                            title="Shape what ships next"
                            description="Sigma Canvas is Apache 2.0 and developed in the open. If you work with lots of media, at a studio or on your own, tell us where it helps and where it breaks. Issues and pull requests are welcome too."
                        />
                        <div class="btn-row contact__action" data-reveal>
                            <a
                                class="btn btn--primary"
                                href={`mailto:${site.contactEmail}`}
                            >
                                {site.contactEmail}
                            </a>
                            {githubUrl && (
                                <a
                                    class="btn"
                                    href={`${githubUrl}/issues`}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    Open an issue
                                    <ExternalArrow size={14} />
                                </a>
                            )}
                        </div>
                    </div>
                    <ContactSignal />
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
