---
import { site } from "../../data/site";
---

<!-- First-visit curtain. Hidden unless the head script sets data-intro="on". -->
<div class="intro" aria-hidden="true">
  <div class="intro__panel intro__panel--top"></div>
  <div class="intro__panel intro__panel--bottom"></div>
  <div class="intro__core">
    <img src={site.logo} width="40" height="40" alt="" />
    <span class="intro__line"></span>
  </div>
</div>
