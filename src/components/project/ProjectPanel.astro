---
import type { Project } from "../../data/projects";
import ArrowRight from "../ui/ArrowRight.astro";
import ExternalArrow from "../ui/ExternalArrow.astro";

interface Props {
  project: Project;
  highlights: readonly string[];
}

const { project, highlights } = Astro.props;
const productLink = project.links.find((link) => !link.external);
const sourceLink = project.links.find((link) => link.external);
---

<div class="card project-panel" data-reveal data-scene-trigger>
  <div>
    <div class="project-panel__kicker">
      <img src={project.media.wordmark} alt="SIGMA" />
    </div>
    <p class="project-panel__tagline">{project.tagline}</p>
    <h3>An infinite canvas for organizing, inspecting, and editing media</h3>
    <p class="project-panel__desc">{project.description}</p>

    <ul class="project-panel__points">
      {highlights.map((highlight) => <li>{highlight}</li>)}
    </ul>

    <div class="btn-row">
      {
        productLink && (
          <a class="btn btn--primary" href={productLink.href}>
            Explore SIGMA
            <ArrowRight />
          </a>
        )
      }
      {
        sourceLink && (
          <a
            class="btn"
            href={sourceLink.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {sourceLink.label}
            <ExternalArrow />
          </a>
        )
      }
    </div>
  </div>

  <div class="project-panel__media">
    <video
      data-autoplay-in-view
      muted
      loop
      playsinline
      preload="none"
      poster="/assets/sigma/sigma-demo-poster.jpg"
      width="1280"
      height="832"
      aria-label="SIGMA's infinite canvas panning across video and image clips arranged spatially"
    >
      <source src="/assets/sigma/sigma-demo.mp4" type="video/mp4" />
    </video>
  </div>
</div>
