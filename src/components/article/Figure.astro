---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

/**
 * A captioned image inside an article. Pass an imported local image to get
 * responsive, optimized output, or a root-relative `/assets/...` path to serve
 * a file from `public/` unchanged.
 */
interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  credit?: string;
  width?: number;
  height?: number;
}

const { src, alt, caption, credit, width, height } = Astro.props;
const hasCaption = Boolean(caption || credit);
---

<figure class="article-media media-frame">
  {
    typeof src === "string" ? (
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <Image
        src={src}
        alt={alt}
        widths={[640, 960, 1280, 1664].filter((w) => w <= src.width)}
        sizes="(min-width: 56rem) 52rem, 100vw"
      />
    )
  }
  {
    hasCaption && (
      <figcaption class="media-frame__caption">
        {caption && <span>{caption}</span>}
        {credit && <span>{credit}</span>}
      </figcaption>
    )
  }
</figure>
